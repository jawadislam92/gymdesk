# ============================================================================
# GymFlow Suite — environment template
# Copy this file to `.env` (root) and `backend/.env`, then fill in real values.
# NEVER commit a real .env — only this .env.example is tracked in git.
# ============================================================================

# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000      # web app URL
API_BASE_URL=http://localhost:4000      # backend API URL
PORT=4000                               # backend port
# Production only: comma-separated list of web origins allowed to call the API.
# Leave blank for local dev (any origin is reflected so localhost works).
CORS_ORIGIN=

# --- Database (PostgreSQL) ---
# Local example: postgresql://postgres:postgres@localhost:5432/gymflow_dev
# Managed (Neon/Railway/Supabase): paste the connection string they give you.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymflow_dev?schema=public

# --- Cache / queues (Redis) ---
# Laragon bundles Redis; default local URL below works once Redis is running.
REDIS_URL=redis://127.0.0.1:6379

# --- Auth (JWT) ---
# Generate strong random values, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- File storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=gymflow-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Payments (Stripe) — optional until Phase 6 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Push notifications (Firebase Cloud Messaging) — optional until Phase 5 ---
FCM_SERVER_KEY=

# --- Transactional email (Resend/Postmark) — optional ---
EMAIL_API_KEY=
EMAIL_FROM=no-reply@gymflow.app
