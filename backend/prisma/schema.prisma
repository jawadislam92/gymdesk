// GymFlow Suite — Prisma schema (source of truth for the data model).
// Mirrors PRODUCT_PLAN.md §8. Multi-tenant: every tenant table carries `gym_id`.
// Conventions: PascalCase models / camelCase fields in TS, snake_case in the DB
// via @@map / @map. UUID ids; created_at/updated_at everywhere; deleted_at where
// soft delete applies. Enum string values match the @gymflow/shared constants.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

enum RoleName {
  super_admin
  gym_owner
  gym_manager
  trainer
  receptionist
  member
}

enum Gender {
  male
  female
  other
}

enum EmploymentType {
  full_time
  part_time
  contract
}

enum MemberStatus {
  active
  frozen
  expired
  cancelled
}

enum MembershipStatus {
  active
  expired
  frozen
  cancelled
}

enum PaymentMethod {
  cash
  card
  online
  bank
}

enum PaymentStatus {
  paid
  pending
  partial
  refunded
  failed
}

enum AttendanceMethod {
  manual
  qr
  biometric
}

enum BookingStatus {
  booked
  attended
  cancelled
  no_show
}

enum NotificationType {
  renewal
  announcement
  class
  payment
  system
}

enum NotificationChannel {
  push
  email
  sms
  in_app
}

enum ExpenseCategory {
  rent
  salary
  utilities
  equipment
  other
}

enum SubscriptionPlan {
  starter
  professional
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

// ──────────────────────────────────────────────────────────────────────────
// Tenancy & identity
// ──────────────────────────────────────────────────────────────────────────

model Gym {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  ownerUserId        String?            @map("owner_user_id")
  address            String?
  city               String?
  country            String?
  currency           String             @default("USD")
  timezone           String             @default("UTC")
  logoUrl            String?            @map("logo_url")
  subscriptionPlan   SubscriptionPlan   @default(starter) @map("subscription_plan")
  subscriptionStatus SubscriptionStatus @default(trialing) @map("subscription_status")
  parentGymId        String?            @map("parent_gym_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  owner     User? @relation("GymOwner", fields: [ownerUserId], references: [id])
  parentGym Gym?  @relation("GymBranches", fields: [parentGymId], references: [id])
  branches  Gym[] @relation("GymBranches")

  users           User[]           @relation("GymUsers")
  roles           Role[]
  userRoles       UserRole[]
  members         Member[]
  trainers        Trainer[]
  staff           Staff[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  payments        Payment[]
  attendance      Attendance[]
  workoutPlans    WorkoutPlan[]
  dietPlans       DietPlan[]
  progressRecords ProgressRecord[]
  classes         GymClass[]
  bookings        Booking[]
  notifications   Notification[]
  expenses        Expense[]
  auditLogs       AuditLog[]
  exercises       Exercise[]
  devices         Device[]

  @@map("gyms")
}

model User {
  id              String    @id @default(uuid())
  gymId           String?   @map("gym_id") // null for super_admin
  email           String    @unique
  phone           String?
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  gym       Gym?  @relation("GymUsers", fields: [gymId], references: [id])
  ownedGyms Gym[] @relation("GymOwner")

  member        Member?
  trainer       Trainer?
  staff         Staff?
  userRoles     UserRole[]
  devices       Device[]
  notifications Notification[]

  @@index([gymId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  gymId       String?  @map("gym_id") // null = system/global role
  name        RoleName
  permissions Json     @default("[]") // array of permission keys
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gym       Gym?       @relation(fields: [gymId], references: [id])
  userRoles UserRole[]

  @@index([gymId, name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  gymId     String?  @map("gym_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  gym  Gym? @relation(fields: [gymId], references: [id])

  @@unique([userId, roleId, gymId])
  @@index([userId])
  @@map("user_roles")
}

// ──────────────────────────────────────────────────────────────────────────
// People: members, trainers, staff
// ──────────────────────────────────────────────────────────────────────────

model Member {
  id                String       @id @default(uuid())
  gymId             String       @map("gym_id")
  userId            String?      @unique @map("user_id") // null for walk-ins without an account
  memberCode        String       @map("member_code")
  dateOfBirth       DateTime?    @map("date_of_birth")
  gender            Gender?
  emergencyContact  String?      @map("emergency_contact")
  healthNotes       String?      @map("health_notes")
  assignedTrainerId String?      @map("assigned_trainer_id")
  status            MemberStatus @default(active)
  joinedAt          DateTime     @default(now()) @map("joined_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  gym             Gym      @relation(fields: [gymId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])
  assignedTrainer Trainer? @relation("TrainerMembers", fields: [assignedTrainerId], references: [id])

  memberships     Membership[]
  payments        Payment[]
  attendance      Attendance[]
  workoutPlans    WorkoutPlan[]
  dietPlans       DietPlan[]
  progressRecords ProgressRecord[]
  bookings        Booking[]

  @@unique([gymId, memberCode])
  @@index([gymId, status])
  @@map("members")
}

model Trainer {
  id             String   @id @default(uuid())
  gymId          String   @map("gym_id")
  userId         String   @unique @map("user_id")
  specialization String?
  bio            String?
  certifications Json?
  hourlyRate     Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  gym  Gym  @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])

  members      Member[]      @relation("TrainerMembers")
  workoutPlans WorkoutPlan[]
  dietPlans    DietPlan[]
  classes      GymClass[]

  @@index([gymId])
  @@map("trainers")
}

model Staff {
  id             String          @id @default(uuid())
  gymId          String          @map("gym_id")
  userId         String          @unique @map("user_id")
  position       String?
  employmentType EmploymentType? @map("employment_type")
  hiredAt        DateTime?       @map("hired_at")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  gym  Gym  @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([gymId])
  @@map("staff")
}

// ──────────────────────────────────────────────────────────────────────────
// Plans, memberships, payments
// ──────────────────────────────────────────────────────────────────────────

model MembershipPlan {
  id           String    @id @default(uuid())
  gymId        String    @map("gym_id")
  name         String
  description  String?
  durationDays Int       @map("duration_days")
  price        Decimal   @db.Decimal(12, 2)
  currency     String    @default("USD")
  classCredits Int?      @map("class_credits") // null = unlimited
  benefits     Json?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  gym         Gym          @relation(fields: [gymId], references: [id])
  memberships Membership[]

  @@index([gymId, isActive])
  @@map("membership_plans")
}

model Membership {
  id          String           @id @default(uuid())
  gymId       String           @map("gym_id")
  memberId    String           @map("member_id")
  planId      String           @map("plan_id")
  startDate   DateTime         @map("start_date")
  endDate     DateTime         @map("end_date")
  status      MembershipStatus @default(active)
  pricePaid   Decimal          @map("price_paid") @db.Decimal(12, 2)
  autoRenew   Boolean          @default(false) @map("auto_renew")
  createdById String?          @map("created_by") // staff user id (actor)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  gym    Gym            @relation(fields: [gymId], references: [id])
  member Member         @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan   MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@index([gymId, status])
  @@index([memberId])
  @@map("memberships")
}

model Payment {
  id            String        @id @default(uuid())
  gymId         String        @map("gym_id")
  memberId      String        @map("member_id")
  membershipId  String?       @map("membership_id")
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  method        PaymentMethod
  status        PaymentStatus @default(paid)
  gateway       String?
  gatewayRef    String?       @map("gateway_ref")
  paidAt        DateTime?     @map("paid_at")
  invoiceNumber String?       @unique @map("invoice_number")
  collectedById String?       @map("collected_by") // staff user id (actor)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  gym        Gym         @relation(fields: [gymId], references: [id])
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([gymId, paidAt])
  @@index([memberId])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────────────────
// Attendance
// ──────────────────────────────────────────────────────────────────────────

model Attendance {
  id           String           @id @default(uuid())
  gymId        String           @map("gym_id")
  memberId     String           @map("member_id")
  checkedInAt  DateTime         @default(now()) @map("checked_in_at")
  checkedOutAt DateTime?        @map("checked_out_at")
  method       AttendanceMethod @default(manual)
  recordedById String?          @map("recorded_by") // staff user id (null = self check-in)
  createdAt    DateTime         @default(now()) @map("created_at")

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([gymId, memberId, checkedInAt])
  @@map("attendance")
}

// ──────────────────────────────────────────────────────────────────────────
// Training: workouts, diet, progress, exercise library
// ──────────────────────────────────────────────────────────────────────────

model Exercise {
  id          String   @id @default(uuid())
  gymId       String?  @map("gym_id") // null = global library
  name        String
  category    String?
  muscleGroup String?  @map("muscle_group")
  mediaUrl    String?  @map("media_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  gym              Gym?              @relation(fields: [gymId], references: [id])
  workoutExercises WorkoutExercise[]

  @@index([gymId])
  @@map("exercises")
}

model WorkoutPlan {
  id        String    @id @default(uuid())
  gymId     String    @map("gym_id")
  memberId  String    @map("member_id")
  trainerId String?   @map("trainer_id")
  title     String
  goal      String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  notes     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  gym     Gym      @relation(fields: [gymId], references: [id])
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id])

  exercises WorkoutExercise[]

  @@index([gymId, memberId])
  @@map("workout_plans")
}

model WorkoutExercise {
  id            String   @id @default(uuid())
  workoutPlanId String   @map("workout_plan_id")
  exerciseId    String?  @map("exercise_id")
  name          String
  dayIndex      Int?     @map("day_index")
  sets          Int?
  reps          Int?
  restSeconds   Int?     @map("rest_seconds")
  weight        Decimal? @db.Decimal(8, 2)
  notes         String?
  mediaUrl      String?  @map("media_url")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise    Exercise?   @relation(fields: [exerciseId], references: [id])

  @@index([workoutPlanId])
  @@map("workout_exercises")
}

model DietPlan {
  id             String    @id @default(uuid())
  gymId          String    @map("gym_id")
  memberId       String    @map("member_id")
  trainerId      String?   @map("trainer_id")
  title          String
  targetCalories Int?      @map("target_calories")
  macros         Json?
  meals          Json?
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  notes          String?
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  gym     Gym      @relation(fields: [gymId], references: [id])
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer Trainer? @relation(fields: [trainerId], references: [id])

  @@index([gymId, memberId])
  @@map("diet_plans")
}

model ProgressRecord {
  id           String   @id @default(uuid())
  gymId        String   @map("gym_id")
  memberId     String   @map("member_id")
  recordedById String?  @map("recorded_by") // trainer or member user id (actor)
  recordedAt   DateTime @default(now()) @map("recorded_at")
  weight       Decimal? @db.Decimal(6, 2)
  bodyFatPct   Decimal? @map("body_fat_pct") @db.Decimal(5, 2)
  measurements Json?
  photoUrls    Json?    @map("photo_urls")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  gym    Gym    @relation(fields: [gymId], references: [id])
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId, memberId, recordedAt])
  @@map("progress_records")
}

// ──────────────────────────────────────────────────────────────────────────
// Classes & bookings (post-MVP feature, schema in place from day one)
// ──────────────────────────────────────────────────────────────────────────

model GymClass {
  id             String   @id @default(uuid())
  gymId          String   @map("gym_id")
  trainerId      String?  @map("trainer_id")
  title          String
  description    String?
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  capacity       Int      @default(0)
  location       String?
  recurrenceRule String?  @map("recurrence_rule")
  isCancelled    Boolean  @default(false) @map("is_cancelled")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  gym      Gym       @relation(fields: [gymId], references: [id])
  trainer  Trainer?  @relation(fields: [trainerId], references: [id])
  bookings Booking[]

  @@index([gymId, startsAt])
  @@map("classes")
}

model Booking {
  id        String        @id @default(uuid())
  gymId     String        @map("gym_id")
  classId   String        @map("class_id")
  memberId  String        @map("member_id")
  status    BookingStatus @default(booked)
  bookedAt  DateTime      @default(now()) @map("booked_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  gym    Gym      @relation(fields: [gymId], references: [id])
  class  GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([classId, memberId])
  @@index([gymId])
  @@map("bookings")
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications, expenses, devices, audit
// ──────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid())
  gymId     String              @map("gym_id")
  userId    String?             @map("user_id") // null = broadcast
  type      NotificationType
  title     String
  body      String?
  channel   NotificationChannel @default(in_app)
  data      Json?
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  gym  Gym   @relation(fields: [gymId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([gymId, userId])
  @@map("notifications")
}

model Expense {
  id           String          @id @default(uuid())
  gymId        String          @map("gym_id")
  category     ExpenseCategory @default(other)
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("USD")
  description  String?
  incurredOn   DateTime        @map("incurred_on")
  recordedById String?         @map("recorded_by") // staff user id (actor)
  receiptUrl   String?         @map("receipt_url")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  gym Gym @relation(fields: [gymId], references: [id])

  @@index([gymId, incurredOn])
  @@map("expenses")
}

model Device {
  id         String    @id @default(uuid())
  gymId      String?   @map("gym_id")
  userId     String    @map("user_id")
  token      String    @unique // FCM token
  platform   String?
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  gym  Gym? @relation(fields: [gymId], references: [id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model AuditLog {
  id          String   @id @default(uuid())
  gymId       String?  @map("gym_id")
  actorUserId String?  @map("actor_user_id")
  action      String // e.g. "payment.refunded"
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  gym Gym? @relation(fields: [gymId], references: [id])

  @@index([gymId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
