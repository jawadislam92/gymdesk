# Backend (.env) — copy to backend/.env and fill in. Never commit backend/.env.
# Prisma reads DATABASE_URL from this file when you run prisma/migrate commands.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymflow_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
